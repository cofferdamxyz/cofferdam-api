{
  "name": "@cofferdam/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cofferdam main HTTP edge — Hono router, REST API, session challenge/exchange, on-chain reads.",
  "license": "Apache-2.0",
  "author": "Cofferdam Inc.",
  "homepage": "https://github.com/cofferdamxyz/cofferdam-api#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cofferdamxyz/cofferdam-api.git"
  },
  "bugs": {
    "url": "https://github.com/cofferdamxyz/cofferdam-api/issues"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "hono": "4.12.23",
    "pg": "8.23.1",
    "viem": "2.51.3"
