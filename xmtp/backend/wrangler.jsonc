/**
 * cofferdam-xmtp-backend: the XMTP 8 backend as a Cloudflare Container
 * (workspace decision 0041). Deploy from the Mac only, with the workspace .envrc:
 *
 *   cd xmtp/backend && direnv exec ../../.. npx wrangler deploy
 *
 * Secrets (wrangler secret put, from this directory), all required before the
 * container can start; containerEnv.ts names any that is missing:
 *   XMTP_DATABASE_URL          direct Postgres 17+ URL (Neon: no `-pooler`)
 *   XMTP_APP_API_KEY           openssl rand -base64 48 (the app holds the same)
 *   XMTP_R2_ENDPOINT           https://<account id>.r2.cloudflarestorage.com
 *   XMTP_R2_ACCESS_KEY_ID      R2 API token, Object Write on the bucket only
 *   XMTP_R2_SECRET_ACCESS_KEY
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cofferdam-xmtp-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",

  // Decision 0039: no logs pairing anything with a connection. This Worker only
  // splices bytes, and it logs nothing at all.
  "observability": { "enabled": false },
  "logpush": false,

  // No public HTTP surface. Ingress is the inbound-TCP slot (src/index.ts).
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // "off" until the Spectrum application for inbound TCP exists and points at
    // this Worker; then "tcp". See docs/runbooks/xmtp-backend.md (workspace).
    "INGRESS": "off",
    // Public RPCs for ERC-1271 checks. Swap for keyed endpoints before load.
    "XMTP_RPC_BASE_SEPOLIA": "https://sepolia.base.org",
    "XMTP_RPC_BASE": "https://mainnet.base.org"
  },

  "containers": [
    {
      "class_name": "XmtpBackend",
      "image": "./Dockerfile",
      // One instance: the backend is stateless but every client must reach the
      // same deployment; scale out by raising this and the DO instance names.
      "max_instances": 1,
      // 1/2 vCPU, 4 GiB. `basic` (1/4 vCPU, 1 GiB) is enough for M0.
      "instance_type": "standard-1",
      // Keep the container near the database: each publish is several round
      // trips under a 5 s statement timeout. Neon project region: US East.
      "constraints": { "regions": ["ENAM"] }
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "XMTP_BACKEND", "class_name": "XmtpBackend" }]
  },
  "migrations": [{ "tag": "v1-xmtp-backend", "new_sqlite_classes": ["XmtpBackend"] }],

  // Every minute: start the container if it stopped, keep the object warm.
  "triggers": { "crons": ["* * * * *"] }
}
