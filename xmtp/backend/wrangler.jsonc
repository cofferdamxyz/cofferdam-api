/**
 * cofferdam-xmtp-backend: the XMTP 8 backend as a Cloudflare Container
 * (workspace decision 0042). Deploy from the Mac only, with the workspace .envrc:
 *
 *   cd xmtp/backend && direnv exec ../../.. npx wrangler deploy
 *
 * Secrets (wrangler secret put, from this directory), all required before the
 * container can start; containerEnv.ts names any that is missing:
 *   XMTP_DATABASE_URL          direct Postgres 17+ URL: PlanetScale on 5432 with
 *                            ?sslmode=verify-full (no sslrootcert=system),
 *                            never 6432 (Neon: no `-pooler`)
 *   XMTP_APP_API_KEY           openssl rand -base64 48 (the app holds the same)
 *   XMTP_R2_ENDPOINT           https://<account id>.r2.cloudflarestorage.com (the
 *                            ACME store's; the backend uploads nothing since
 *                            2026-11-23, so XMTP_R2_ACCESS_KEY_ID and
 *                            XMTP_R2_SECRET_ACCESS_KEY are no longer read)
 *   XMTP_ACME_R2_ACCESS_KEY_ID      R2 token, Object Read & Write on the
 *   XMTP_ACME_R2_SECRET_ACCESS_KEY  cofferdam-xmtp-tls bucket only: Spectrum on the
 *                                   Pro zone passes TLS through, so the container's
 *                                   Caddy obtains and renews the certificate itself
 *                                   (TLS-ALPN-01) and keeps it there
 * Optional override (the emergency path, scripts/xmtp/tls-renew.sh in the workspace):
 *   XMTP_TLS_CERT, XMTP_TLS_KEY     a PEM pair for xmtp.cofferdam.xyz; when both
 *                                   are set they win over Caddy's own certificate
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cofferdam-xmtp-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",

  // Decision 0039: no logs pairing anything with a connection. This Worker only
  // splices bytes, and it logs nothing at all.
  "observability": { "enabled": false },
  "logpush": false,

  // No public HTTP surface. Ingress is the inbound-TCP slot (src/index.ts).
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    // "tcp": the Spectrum application (xmtp.cofferdam.xyz, TCP 443, Worker
    // origin; public beta since 2026-11-19) reaches this Worker; "off" refuses it.
    // See docs/runbooks/xmtp-backend.md (workspace).
    "INGRESS": "tcp",
    // "on" keeps the container up around the clock; "off" pauses it (src/index.ts).
    // Paused 2026-11-04 to 2026-11-21 while nothing could reach it; on again with
    // inbound TCP for the M0 phone test (the founder, 2026-11-21).
    "RUN": "on",
    // Caddy's certificate store (Caddyfile.acme, start.sh). "staging" is Let's
    // Encrypt's test CA, which phones do not trust; issuance through Spectrum
    // was proven there on 2026-11-21 (gRPC health SERVING), so "production"
    // (decision 0042, amended 2026-11-20). Let's Encrypt allows 5 a week per
    // name: never loop deploys.
    "XMTP_ACME_BUCKET": "cofferdam-xmtp-tls",
    "XMTP_ACME_CA": "production",
    // Public RPCs for ERC-1271 checks. Swap for keyed endpoints before load.
    "XMTP_RPC_BASE_SEPOLIA": "https://sepolia.base.org",
    "XMTP_RPC_BASE": "https://mainnet.base.org"
  },

  "containers": [
    {
      "class_name": "XmtpBackend",
      "image": "./Dockerfile",
      // One instance: the backend is stateless but every client must reach the
      // same deployment; scale out by raising this and the DO instance names.
      "max_instances": 1,
      // 1/4 vCPU, 1 GiB, 4 GB disk: enough for testing (the founder's pick of
      // 2026-11-19, about $7 a month always on). `standard-1` (1/2 vCPU, 4 GiB)
      // when real traffic arrives.
      "instance_type": "basic",
      // Keep the container near the database: each publish is several round
      // trips under a 5 s statement timeout. PlanetScale region: AWS us-east-1.
      "constraints": { "regions": ["ENAM"] }
    }
  ],

  // Read by CertificateStatus only (the Ops bot's expiry check); the container
  // writes the bucket with its own scoped token. Create the bucket before the
  // deploy that carries this binding.
  "r2_buckets": [{ "binding": "XMTP_TLS_STORE", "bucket_name": "cofferdam-xmtp-tls" }],

  "durable_objects": {
    "bindings": [{ "name": "XMTP_BACKEND", "class_name": "XmtpBackend" }]
  },
  "migrations": [{ "tag": "v1-xmtp-backend", "new_sqlite_classes": ["XmtpBackend"] }],

  // Every minute: start the container if it stopped, keep the object warm.
  "triggers": { "crons": ["* * * * *"] }
}
