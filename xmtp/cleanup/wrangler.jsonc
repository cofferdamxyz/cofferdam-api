/**
 * cofferdam-xmtp-cleanup: hourly deletion of expired XMTP envelopes
 * (workspace decision 0042). Deploy from the Mac only:
 *
 *   cd xmtp/cleanup && direnv exec ../../.. npx wrangler deploy
 *
 * Only after the backend has booted against the database once: it creates the
 * tables, and the hourly run fails on missing ones before that.
 *
 * Hyperdrive (caching disabled) points at the backend's PlanetScale Postgres,
 * port 5432, as the cleanup role (reads and deletes expired rows only).
 * Hyperdrive pools in front of it; that is fine for this job, never for the
 * backend. Both ids below were created on 2026-10-23.
 */
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cofferdam-xmtp-cleanup",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],

  // Counts only (src/index.ts). No request ever reaches this Worker.
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,

  "triggers": { "crons": ["17 * * * *"] },

  "vars": {
    // Mirrors xmtp/backend/backend.toml [retention] (test/xmtp/config.test.ts).
    // The job never deletes before a row's own expiry_ns; these values only
    // reset the resume points when retention changes.
    "RETENTION_GROUP_MESSAGE_SECONDS": "2592000",
    "RETENTION_WELCOME_SECONDS": "7776000",
    "RETENTION_KEY_PACKAGE_SECONDS": "7776000",
    "GRACE_SECONDS": "604800",
    "BATCH_SIZE": "5000",
    "PUSH_CURSOR_GUARD": "on"
  },

  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "fe0d773fd1f84e46b9519408d952d9a7" }],
  "kv_namespaces": [{ "binding": "CLEANUP_STATE", "id": "8d91e16741a74c1d8b85ddc4cbb5256b" }]
}
