/**
 * Cofferdam API Worker — Cloudflare config.
 *
 * Schema reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Bindings declared here are all NAMED but mostly NOT YET PROVISIONED (KV,
 * R2, D1 IDs are placeholders). They're declared so the env-types compile;
 * actual provisioning happens via `wrangler kv:namespace create ...`,
 * `wrangler r2 bucket create ...`, `wrangler d1 create ...` in later
 * sessions when those surfaces light up.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofferdam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],

  // Observability — enable Workers Logs (free tier, 7-day retention).
  "observability": {
    "enabled": true
  },

  // The workers.dev hostname serves end-to-end testing from the RN app.
  "workers_dev": true,

  // Self.xyz delivers the bind proof to `SelfApp.endpoint`, and only that
  // URL's HOST enters the immutable NullifierRegistry.expectedScope
  // (Poseidon(cofferdam.xyz × cofferdam-bind-v1)). The proof endpoint
  // therefore lives on the apex, not on api.cofferdam.xyz: this zone route
  // puts /v1/* of cofferdam.xyz on this Worker ahead of the Pages site.
  // Requires the cofferdam.xyz zone in the same Cloudflare account as the
  // Worker; `wrangler deploy` fails loudly otherwise.
  "routes": [
    { "pattern": "cofferdam.xyz/v1/*", "zone_name": "cofferdam.xyz" }
  ],

  // Variables — non-secret. Secrets live in `wrangler secret put`.
  //
  // Neon Postgres — `polis` DB only (workspace `docs/product/enterprise.md`, decision
  // 2026-06-26). Secret, set with:
  //   wrangler secret put POLIS_DATABASE_URL      # `polis` DB (enterprise identity)
  // Use Neon's POOLED HTTP endpoint URL (the Worker reads via
  // `@neondatabase/serverless`). Until set, DB-backed routes return 503
  // `db_unprovisioned` (env.ts declares it as optional).
  // ACTIVITY_DATABASE_URL is retained as optional future fallback but is NOT
  // required — `/v1/activity` uses the SQD Portal Stream API directly.
  "vars": {
    // Deployed value. Local `wrangler dev` overrides it to "development" via
    // .dev.vars (bind-bundle pickup then tolerates a missing csa1 token).
    "ENVIRONMENT": "staging",
    "BASE_SEPOLIA_RPC_URL": "https://sepolia.base.org",
    // Celo mainnet, read-only: Self.xyz's identity registry lives there and
    // the attester's bind gate checks every proof against it. Must agree with
    // cofferdam-attester's CELO_RPC_URL chain (42220).
    "CELO_RPC_URL": "https://forno.celo.org",
    "SQD_PORTAL_URL": "https://portal.sqd.dev/datasets/base-sepolia"
  },

  // ─────────────────────────────────────────────────────────────────
  // Service bindings — cross-Worker calls (private, no public ingress).
  //
  // ATTESTER → cofferdam-attester (Session 3).
  //   Holds the SelfAttester ECDSA key and signs bind messages over
  //   Workers RPC. Local dev: both workers must be running (`yarn dev`
  //   in each); wrangler 4 auto-discovers the binding via the local
  //   registry. Production: both workers deploy to the same Cloudflare
  //   account and the binding resolves at request time.
  // ─────────────────────────────────────────────────────────────────
  "services": [
    { "binding": "ATTESTER", "service": "cofferdam-attester" }
  ],

  // ─────────────────────────────────────────────────────────────────
  // Durable Objects — the Self bind-bundle hand-off (decision 0010).
  // One SQLite-backed object per account; strongly consistent, so the app's
  // pickup sees the relayer's write at once. Replaced the BIND_BUNDLES KV
  // namespace (69731266425143ab9fb883e6ce6637b9, now unused) on 2026-10-11.
  // ─────────────────────────────────────────────────────────────────
  "durable_objects": {
    "bindings": [{ "name": "BIND_BUNDLES_DO", "class_name": "BindBundleDO" }]
  },
  "migrations": [{ "tag": "v1-bind-bundles", "new_sqlite_classes": ["BindBundleDO"] }],

  // ─────────────────────────────────────────────────────────────────
  // Rate limits — permissive, per-colo, keyed in routes/self.ts. A bind is
  // at most two relayer posts and ~15 pickup polls a minute.
  // ─────────────────────────────────────────────────────────────────
  "ratelimits": [
    { "name": "SELF_VERIFY_RL", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    { "name": "SELF_PICKUP_RL", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } },
    { "name": "AA_RELAY_RL", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } },
    { "name": "CEREMONY_RL", "namespace_id": "1104", "simple": { "limit": 10, "period": 60 } }
  ]

  // Bindings below are intentionally COMMENTED until their resources
  // are provisioned. Uncomment + fill IDs as we go through Sessions 4-N.
  //
  // ─────────────────────────────────────────────────────────────────
  // KV — session storage, profile pointers, Bloom filter snapshots,
  //      CompanyConsumerLink grants (rev-7.4 company plane).
  //
  // To light up the /v1/enterprise/links/* routes:
  //   1. wrangler kv namespace create LINKS
  //   2. paste the returned id below and uncomment the LINKS line
  //   (env.ts already declares `LINKS?: KVNamespace` as optional — no change there)
  // Until then the link routes return 503 link_store_unprovisioned and the
  // rest of the Worker (incl. /v1/enterprise/resolve) is unaffected.
  // ─────────────────────────────────────────────────────────────────
  // Add a `kv_namespaces` array once these are provisioned (env.ts declares
  // `LINKS?: KVNamespace` as optional):
  //   { "binding": "SESSIONS", "id": "<TBD-session-3>" },
  //   { "binding": "PROFILES", "id": "<TBD-after-T1.1>" },
  //   { "binding": "LINKS",    "id": "<TBD-run-wrangler-kv-namespace-create-LINKS>" }
  //
  // ─────────────────────────────────────────────────────────────────
  // R2 — encrypted blobs (vault docs, attachments, SRS)
  // ─────────────────────────────────────────────────────────────────
  // "r2_buckets": [
  //   { "binding": "VAULT", "bucket_name": "cofferdam-vault" },
  //   { "binding": "SRS",   "bucket_name": "cofferdam-srs" }
  // ],
  //
  // ─────────────────────────────────────────────────────────────────
  // D1 — non-sensitive metadata + audit logs
  // ─────────────────────────────────────────────────────────────────
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "cofferdam", "database_id": "<TBD>" }
  // ],
  //
  // ─────────────────────────────────────────────────────────────────
  // Durable Objects — SessionDO, ConversationDO, etc.
  // ─────────────────────────────────────────────────────────────────
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "SESSION_DO", "class_name": "SessionDO" }
  //   ]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_classes": ["SessionDO"] }
  // ],
}
