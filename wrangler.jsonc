/**
 * Cofferdam API Worker — Cloudflare config.
 *
 * Schema reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Bindings declared here are all NAMED but mostly NOT YET PROVISIONED (KV,
 * R2, D1 IDs are placeholders). They're declared so the env-types compile;
 * actual provisioning happens via `wrangler kv:namespace create ...`,
 * `wrangler r2 bucket create ...`, `wrangler d1 create ...` in later
 * sessions when those surfaces light up.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cofferdam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-30",
  "compatibility_flags": ["nodejs_compat"],

  // Observability — Workers Logs on (free tier, 7-day retention) without the
  // automatic invocation record: that record carries each request's URL, and a
  // Vault URL names an account beside an object id (workspace decision 0081,
  // Rulings 12; the founder, 2026-11-11: "Turn it off"). What the plane writes
  // still reaches Workers Logs: the request line (src/index.ts, Vault paths
  // redacted), the JSON lines, errors and uncaught exceptions.
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },

  // The workers.dev hostname serves end-to-end testing from the RN app.
  "workers_dev": true,

  // Self.xyz delivers the bind proof to `SelfApp.endpoint`, and only that
  // URL's HOST enters the immutable NullifierRegistry.expectedScope
  // (Poseidon(cofferdam.xyz × cofferdam-bind-v1)). The proof endpoint
  // therefore lives on the apex, not on api.cofferdam.xyz: this zone route
  // puts /v1/* of cofferdam.xyz on this Worker ahead of the Pages site.
  // Requires the cofferdam.xyz zone in the same Cloudflare account as the
  // Worker; `wrangler deploy` fails loudly otherwise.
  "routes": [
    { "pattern": "cofferdam.xyz/v1/*", "zone_name": "cofferdam.xyz" }
  ],

  // Variables — non-secret. Secrets live in `wrangler secret put`.
  //
  // Neon Postgres — `polis` DB only (workspace `docs/product/enterprise.md`, decision
  // 2026-06-26). Secret, set with:
  //   wrangler secret put POLIS_DATABASE_URL      # `polis` DB (enterprise identity)
  // Use Neon's POOLED HTTP endpoint URL (the Worker reads via
  // `@neondatabase/serverless`). Until set, DB-backed routes return 503
  // `db_unprovisioned` (env.ts declares it as optional).
  // ACTIVITY_DATABASE_URL is retained as optional future fallback but is NOT
  // required — `/v1/activity` uses the SQD Portal Stream API directly.
  "vars": {
    // Deployed value. Local `wrangler dev` overrides it to "development" via
    // .dev.vars (bind-bundle pickup then tolerates a missing csa1 token).
    "ENVIRONMENT": "staging",
    "BASE_SEPOLIA_RPC_URL": "https://sepolia.base.org",
    // Base mainnet reads (workspace decision 0080): off. On only for exactly
    // "true" with BASE_RPC_URL set (no default; the Base-mainnet fork in
    // development, a keyed provider's URL as a secret), and even then every
    // path answers chain_unsupported until its contracts are in the plane's
    // mainnet table, which is empty (src/chain/chains.ts), except the relay's
    // test lane below, which takes its addresses from its own var and signs
    // with its own key.
    "BASE_MAINNET_ENABLED": "false",
    // The Base mainnet test relay (decision 0080, M2; src/services/testRelay.ts):
    // off. On needs exactly "true" with BASE_MAINNET_ENABLED, BASE_RPC_URL,
    // BASE_MAINNET_TEST_DEPLOYMENTS (the test generation's addresses, set on a
    // test deployment only), AA_MAINNET_TEST_ACCOUNTS and the secret
    // RELAYER_MAINNET_TEST_PRIVATE_KEY.
    "AA_MAINNET_TEST_RELAY": "false",
    // Who signs the relay and the handle registrar (workspace decision 0090,
    // cdp-setup.md E4; src/services/hotSigner.ts): "key" (the raw secrets
    // RELAYER_PRIVATE_KEY and HANDLE_REGISTRAR_KEY) or "cdp" (the CDP accounts
    // RELAYER_CDP_ADDRESS and HANDLE_REGISTRAR_CDP_ADDRESS, set here, with the
    // secrets CDP_API_KEY_ID, CDP_API_KEY_SECRET and CDP_WALLET_SECRET). No
    // fallback: "cdp" without them answers 503. Sepolia's relayer under "cdp"
    // also needs the Sepolia paymaster's setRelayer (decision 0071).
    "RELAYER_SIGNER": "key",
    "HANDLE_REGISTRAR_SIGNER": "key",
    // The hot keys' daily budgets (decision 0090 item 11; src/services/keyBudgetStore.ts),
    // JSON by role: calls and gasWei alert, hardCalls and hardGasWei refuse, the
    // hard stop well above normal use. Unset until the founder sets the figures (C2):
    // "KEY_BUDGETS": "{\"relayer\":{\"calls\":2000,\"gasWei\":\"50000000000000000\",\"hardCalls\":20000,\"hardGasWei\":\"500000000000000000\"}}",
    // Celo mainnet, read-only: Self.xyz's identity registry lives there and
    // the attester's bind gate checks every proof against it. Must agree with
    // cofferdam-attester's CELO_RPC_URL chain (42220).
    "CELO_RPC_URL": "https://forno.celo.org",
    "SQD_PORTAL_URL": "https://portal.sqd.dev/datasets/base-sepolia",
    // The handle registry's claim, registrar and relay (workspace decision 0086,
    // src/services/handles/config.ts). The Sepolia test deployment goes without
    // the three checks no build has yet (App Attest / Play Integrity, 0082's
    // install proof, the pinned locator); production ignores this list, and so
    // does any handles chain but Base Sepolia, whatever ENVIRONMENT says. The
    // production cut deletes this line and sets ENVIRONMENT to "production".
    "HANDLES_SKIP_UNBUILT_GATES": "device-attestation,install-proof,locator-pin",
    // Short relay delays on the test deployment, so a claim and a release land
    // within a device test (rule 3's minutes-to-hours and one-to-seven days are
    // the defaults when unset).
    "HANDLES_RELAY_DELAY_S": "30,120",
    "HANDLES_RELEASE_DELAY_S": "60,300",
    // A claim lands at least this long after its account's deployment (rule 3:
    // never the same hour, the default of 3600 when unset); a minute on the test
    // deployment, so a new account's claim lands within a device test.
    "HANDLES_DEPLOY_GAP_S": "60",
    // The quarantine the Sepolia anchor is deployed with (base-contracts
    // deploy-handle-anchor.ts's default, one day); unset means 0086's 365.
    "HANDLES_QUARANTINE_DAYS": "1",
    // CofferdamHandleAnchor on Base Sepolia (deployed 2026-11-20, block 61532195;
    // base-contracts deployments/baseSepolia.json). Needs the secrets HANDLE_REGISTRAR_KEY
    // (address 0x17838cDF0788eF83a70E95A645D7C1E9ac107E19), HANDLES_MAP_KEY and HANDLE_STATEMENT_KEY.
    "HANDLE_ANCHOR_ADDRESS": "0x8b346614EBC7eE242eCB2Bb5F04D9CBF91ed1aA8",
    // First block the webhook-fed activity store is complete from (decision
    // 0032). The head block read right after both CDP subscriptions (MockUSDC
    // 7bb4899b-a0ab-4848-bd09-f86935c1c813, pBRL 7b025699-22f1-4b38-8507-ce9344229420)
    // were created on 2026-11-26, so both are complete from it. A token subscribed
    // later needs a block of its own first. ACTIVITY_RPC_URL (the CDP Node URL,
    // carrying a client key) and CDP_WEBHOOK_SECRET are secrets, never vars.
    "ACTIVITY_INDEX_FROM_BLOCK": "64057465",
    // Inclusive eth_getLogs span per call; 200 is the public node's cap.
    "ACTIVITY_LOG_RANGE": "200",
    // Chat fair-use cap per account per UTC month, in US dollars of estimated
    // model cost: about three times a five-turns-a-day month (founder,
    // 2026-10-20; dollars, not tokens, so a model change keeps what it buys).
    // Remove the line for no cap.
    "CHAT_MONTHLY_USD_CAP": "0.06",
    // Thinking tier (decision 0047, amended 2026-10-21): a Thinking answer runs
    // the reasoning model (DeepSeek V4.1 Flash) at high effort when Clef's
    // reasoning score (0 to 1) is at or above this; 0.7 is the legend's
    // "conditions to weigh" and above. Remove the line to stay at low effort always.
    "CHAT_THINKING_HIGH_FLOOR": "0.7",
    // The router's hiring check (workspace decision 0073, the founder's "layer 0"): a
    // message Clef rates at or above this as asking for a worker opens the hirer's
    // flow (`post_job`: the app's Find workers, with the message), and 0.7 when the
    // action question chose a payment or a message (`HIRE_OVER_PAYMENT`). Set on
    // 2026-10-31, once the app had the action; remove the line to stop asking.
    "CHAT_HIRE_FLOOR": "0.5",
    // Global brake: the most the plane spends on hosted AI (chat and, once
    // built, cloud document extraction) in a UTC month, in US dollars, as the
    // usage meter estimates it (founder, 2026-10-20). Remove for no brake.
    "AI_MONTHLY_BUDGET_USD": "500",
    // The AI Gateways (infra/ai-gateways.json; decisions 0021 (f) and (h),
    // 0037): the strict one carries typed text and blocks personal data, the
    // documents one carries the whole-CV parse. Both created and verified on
    // 2026-10-29 (`scripts/ai-gateway/apply.mjs`, `verify.mjs`); a var that
    // names a gateway that does not exist fails every inference call
    // (runbook: AI Gateways).
    "AI_GATEWAY_ID": "cofferdam-strict",
    "AI_GATEWAY_DOCUMENTS_ID": "cofferdam-documents",
    // The embedding generation of the token registry and the listings: v2,
    // EmbeddingGemma 2's LiteRT-LM file (workspace decision 0068, the entry
    // "The removal"; switched 2026-10-30). The phone runs it, and the indexes
    // below hold the same file's vectors; a Cofferdam Local phone sends its
    // vectors, which every Work route takes (plane.md, Client vectors).
    "WORK_EMBED_MODEL": "litertlm:litert-community/embeddinggemma-2-text-270m-litert-lm:embeddinggemma-2-text-270m.litertlm",
    // Cofferdam Cloud's embedder for a request that carries no vector (workspace
    // decision 0084): Workers AI's EmbeddingGemma 2, the one stand-in the v2 pin
    // takes (`PLANE_STAND_INS`), through the documents gateway.
    "WORK_EMBED_CLOUD_MODEL": "@cf/google/embeddinggemma-2"
  },

  // The deployed version id, shown by GET /v1/privacy/ai beside the live gateway settings.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // ─────────────────────────────────────────────────────────────────
  // Service bindings — cross-Worker calls (private, no public ingress).
  //
  // ATTESTER → cofferdam-attester (Session 3).
  //   Holds the SelfAttester ECDSA key and signs bind messages over
  //   Workers RPC. Local dev: both workers must be running (`yarn dev`
  //   in each); wrangler 4 auto-discovers the binding via the local
  //   registry. Production: both workers deploy to the same Cloudflare
  //   account and the binding resolves at request time.
  // ─────────────────────────────────────────────────────────────────
  "services": [
    { "binding": "ATTESTER", "service": "cofferdam-attester" }
  ],

  // ─────────────────────────────────────────────────────────────────
  // Durable Objects — the Self bind-bundle hand-off (decision 0010).
  // One SQLite-backed object per account; strongly consistent, so the app's
  // pickup sees the relayer's write at once. Replaced the BIND_BUNDLES KV
  // namespace (69731266425143ab9fb883e6ce6637b9, now unused) on 2026-10-11.
  // ─────────────────────────────────────────────────────────────────
  //
  // ACTIVITY_DO (decision 0032): one SQLite-backed object per (chain, address)
  // holding the token transfers the CDP onchain webhook delivers. It stays
  // empty and unread until CDP_WEBHOOK_SECRET and ACTIVITY_INDEX_FROM_BLOCK
  // are set.
  //
  // CHAT_USAGE_DO: one SQLite-backed object per account, the chat's usage
  // meter (one row per UTC month: turns, tokens, router calls, estimated cost).
  //
  // POP_REPLAY_DO (workspace decision 0055): one SQLite-backed object per
  // csa1 v2 device key, remembering each proof jti for two minutes and each
  // slow token until it expires, so neither works twice.
  //
  // VAULT_HANDOFF_DO (workspace decision 0081, step 5): one SQLite-backed
  // object per keyHash and account, the device-link ceremony's relay. It holds the old
  // phone's sealed Vault roots for ten minutes, one slot per account, and
  // hands them to the new phone once. Its migration, v5-vault-handoff, is
  // the founder's to deploy.
  //
  // ATTACHMENT_QUOTA_DO (workspace decision 0093): one SQLite-backed object per
  // account with the class bytes of attachment tokens granted per UTC day for 30
  // days, and one plane-wide for the daily ceiling; nothing else.
  // ATTACHMENT_ISSUER_DO: one object, `issuer`, that makes each 30-day epoch's
  // class keys and keeps them wrapped under the secret ATTACHMENT_KEY_WRAP.
  // Their migration, v6-attachments, is the founder's to deploy.
  // KEY_BUDGET_DO (workspace decision 0090 item 11, cdp-setup.md E5): one
  // SQLite-backed object per hot key, role and chain, counting the key's sends
  // and the gas they paid per UTC day; the var KEY_BUDGETS sets the budget that
  // alerts and the hard stop that refuses (unset: counted, never refused). Its
  // migration, v7-key-budget, is the founder's to deploy.
  "durable_objects": {
    "bindings": [
      { "name": "BIND_BUNDLES_DO", "class_name": "BindBundleDO" },
      { "name": "ACTIVITY_DO", "class_name": "ActivityDO" },
      { "name": "CHAT_USAGE_DO", "class_name": "ChatUsageDO" },
      { "name": "POP_REPLAY_DO", "class_name": "PopReplayDO" },
      { "name": "VAULT_HANDOFF_DO", "class_name": "VaultHandoffDO" },
      { "name": "ATTACHMENT_QUOTA_DO", "class_name": "AttachmentQuotaDO" },
      { "name": "ATTACHMENT_ISSUER_DO", "class_name": "AttachmentIssuerDO" },
      { "name": "KEY_BUDGET_DO", "class_name": "KeyBudgetDO" }
    ]
  },
  // Workers AI, reached only through src/services/inference (decision 0037).
  // Model pins: the AI_PINS KV namespace (model:<op>) once created, else the
  // CHAT_*_MODEL vars, else the defaults in the seam. AI_GATEWAY_ID (a var)
  // sends every call through the strict AI Gateway once it exists, and
  // AI_GATEWAY_DOCUMENTS_ID the whole-CV parse through the documents one.
  "ai": { "binding": "AI" },

  "migrations": [
    { "tag": "v1-bind-bundles", "new_sqlite_classes": ["BindBundleDO"] },
    { "tag": "v2-activity", "new_sqlite_classes": ["ActivityDO"] },
    { "tag": "v3-chat-usage", "new_sqlite_classes": ["ChatUsageDO"] },
    { "tag": "v4-pop-replay", "new_sqlite_classes": ["PopReplayDO"] },
    { "tag": "v5-vault-handoff", "new_sqlite_classes": ["VaultHandoffDO"] },
    { "tag": "v6-attachments", "new_sqlite_classes": ["AttachmentQuotaDO", "AttachmentIssuerDO"] },
    { "tag": "v7-key-budget", "new_sqlite_classes": ["KeyBudgetDO"] }
  ],

  // ─────────────────────────────────────────────────────────────────
  // Rate limits — permissive, per-colo, keyed in the routes. A bind is at
  // most two relayer posts and ~15 pickup polls a minute. Routes a caller
  // must authenticate to (pickup, ceremony, relay, chat) run a global brake,
  // then a per-IP ceiling (the *_IP_RL bindings), and count the per-account
  // bucket only once the gate passes (for the relay: policy and the handleOps
  // simulation), so knowing an address cannot lock its owner out.
  // ─────────────────────────────────────────────────────────────────
  "ratelimits": [
    { "name": "SELF_VERIFY_RL", "namespace_id": "1101", "simple": { "limit": 30, "period": 60 } },
    { "name": "SELF_PICKUP_RL", "namespace_id": "1102", "simple": { "limit": 60, "period": 60 } },
    { "name": "AA_RELAY_RL", "namespace_id": "1103", "simple": { "limit": 30, "period": 60 } },
    { "name": "CEREMONY_RL", "namespace_id": "1104", "simple": { "limit": 10, "period": 60 } },
    // /v1/chat (decision 0037): a typed turn is a few seconds; 20 a minute per account.
    { "name": "CHAT_RL", "namespace_id": "1105", "simple": { "limit": 20, "period": 60 } },
    // /v1/chat before the gate: generous, since carriers put many phones behind one address.
    { "name": "CHAT_IP_RL", "namespace_id": "1106", "simple": { "limit": 120, "period": 60 } },
    // Per-IP ceilings before the gate on pickup, ceremony and relay, as generous as chat's.
    { "name": "SELF_PICKUP_IP_RL", "namespace_id": "1107", "simple": { "limit": 120, "period": 60 } },
    { "name": "CEREMONY_IP_RL", "namespace_id": "1108", "simple": { "limit": 120, "period": 60 } },
    { "name": "AA_RELAY_IP_RL", "namespace_id": "1109", "simple": { "limit": 120, "period": 60 } },
    // The Base mainnet test relay (decision 0080, M2), counted once policy and
    // the pre-flights pass: aa-test:global and aa-test:<sender> share this
    // ceiling, a create and a bind with a retry each, so no one resend of a
    // signed op reaches the chain thirty times a minute at the relayer's cost.
    { "name": "AA_TEST_RELAY_RL", "namespace_id": "1115", "simple": { "limit": 4, "period": 60 } },
    // /v1/work, the Work parser's cloud executor (workspace decision 0021) and
    // the listing toggle: a CV is one classification and about seven block
    // extractions, so 30 a minute per account; the global key is the route's
    // brake, as for chat. /v1/jobs (the hirer query) counts on its own
    // jobs:global and jobs:<account> keys here, and taking a listing down on
    // work-off:global and work-off:<account>, so no other traffic blocks it.
    { "name": "WORK_RL", "namespace_id": "1110", "simple": { "limit": 30, "period": 60 } },
    // /v1/work and /v1/jobs before the gate (work-ip:, jobs-ip: and work-off-ip: keys): as generous as chat's.
    { "name": "WORK_IP_RL", "namespace_id": "1111", "simple": { "limit": 120, "period": 60 } },
    // /v1/vault (workspace decision 0081, the mirror): a save puts a blob and the
    // snapshot object, so 60 a minute per account (vault:<account>), counted
    // after the gate; the global brake has its own binding, since every key on
    // one binding shares its ceiling and the per-account one is too low for
    // every phone together.
    { "name": "VAULT_RL", "namespace_id": "1112", "simple": { "limit": 60, "period": 60 } },
    // /v1/vault before the gate (vault-ip:<ip>): as generous as chat's.
    { "name": "VAULT_IP_RL", "namespace_id": "1113", "simple": { "limit": 120, "period": 60 } },
    // /v1/vault's global brake (vault:global), first on every route.
    { "name": "VAULT_GLOBAL_RL", "namespace_id": "1114", "simple": { "limit": 600, "period": 60 } },
    // The handle registry's public routes (workspace decision 0086, rule 4): per IP
    // (handles-ip:, handshake-ip:, announce-ip:), as generous as chat's, then their
    // global brake (handles:global, handshake:global, announce:global). No IP is stored.
    // Ids from 1121: 1115 is AA_TEST_RELAY_RL on claude/zkp-plane-relay-fixes, and 1116 to 1120 stay free for it.
    { "name": "HANDLES_IP_RL", "namespace_id": "1121", "simple": { "limit": 120, "period": 60 } },
    { "name": "HANDLES_GLOBAL_RL", "namespace_id": "1122", "simple": { "limit": 600, "period": 60 } },
    // A share link's upload, the one anonymous write: far lower, on bindings of its own
    // (handshake-put-ip:, handshake-put:global), beside a ceiling on the live links in HANDLES_DB.
    { "name": "HANDSHAKE_PUT_IP_RL", "namespace_id": "1123", "simple": { "limit": 10, "period": 60 } },
    { "name": "HANDSHAKE_PUT_GLOBAL_RL", "namespace_id": "1124", "simple": { "limit": 120, "period": 60 } },
    // The authenticated handle routes (claim, hold, addresses, discovery, rename, release and the
    // registrar's actions), per account after the session and the High check (handles-acct:<account>).
    { "name": "HANDLES_ACCOUNT_RL", "namespace_id": "1125", "simple": { "limit": 20, "period": 60 } },
    // POST /v1/messages/attachments/tokens (workspace decision 0093): the global brake
    // (attachments:global), a per-IP ceiling (attachments-ip:), then per account once the
    // session and the High check pass (attachments:<account>); a phone tops up a small wallet.
    { "name": "ATTACHMENT_GLOBAL_RL", "namespace_id": "1126", "simple": { "limit": 600, "period": 60 } },
    { "name": "ATTACHMENT_IP_RL", "namespace_id": "1127", "simple": { "limit": 60, "period": 60 } },
    { "name": "ATTACHMENT_RL", "namespace_id": "1128", "simple": { "limit": 10, "period": 60 } },
    // POST /v1/testnet/brs/mint (pBRL on Base Sepolia through Pods' sandbox,
    // workspace decision 0100): per account, after the gate.
    { "name": "BRS_MINT_RL", "namespace_id": "1129", "simple": { "limit": 4, "period": 60 } },
    // The same route's global brake and per-IP ceiling, both before the body.
    { "name": "BRS_MINT_GLOBAL_RL", "namespace_id": "1130", "simple": { "limit": 60, "period": 60 } },
    { "name": "BRS_MINT_IP_RL", "namespace_id": "1131", "simple": { "limit": 10, "period": 60 } }
  ],

  // ─────────────────────────────────────────────────────────────────
  // Cofferdam Work (workspace docs/product/engine.md; decisions 0018, 0019),
  // created by the founder on 2026-10-24 (docs/runbooks/cloudflare-deploys.md,
  // Cofferdam Work resources): D1 cofferdam-work with migrations/work applied.
  // The Vectorize indexes are the v2 generation, created 2026-10-30 (runbook,
  // The v2 generation; the v1 indexes were deleted that day):
  // token-registry-v2 (metadata index kind) and jobs-listings-v2 (metadata
  // index tier, namespaced by coarse region and scope, decision 0019), both
  // 768 dimensions, cosine. A metadata index must exist before the first insert, or those
  // vectors cannot be filtered. The listing routes also need the secret
  // WORK_PSEUDONYM_KEY (set 2026-10-24): the HMAC key of the account's Work
  // pseudonym. Rotating it changes every pseudonym, and no listing can be
  // re-keyed in place, so a rotation takes every listing down first and the
  // phones publish again.
  //
  // "remote": true (the founder, 2026-10-24): wrangler dev, which the app on a
  // device tests against, reaches these live resources, since Vectorize has
  // no local mode. So a local run reads and writes the deployed plane's
  // registry and listings: a listing published from wrangler dev is a real
  // listing, and .dev.vars needs the deployed WORK_PSEUDONYM_KEY, or it lands
  // under a pseudonym the deployed Worker never derives.
  // ─────────────────────────────────────────────────────────────────
  "d1_databases": [
    { "binding": "WORK_DB", "database_name": "cofferdam-work", "database_id": "bcaf84d1-c870-4e4e-85e9-6b0dd822ecd5", "migrations_dir": "migrations/work", "remote": true },
    // The handle registry (workspace decision 0086, rule 4; runbook
    // docs/runbooks/handles-build.md, step 3): handles, the reserved list, the
    // hold log, share links and the announcement feed. Created 2026-11-17
    // (ENAM); unbound, every handle route answers 503 handles_db_unprovisioned.
    // The test registry: `cofferdam-handles-sepolia` holds the test handles until
    // the production cut at the MVP, which creates a fresh `cofferdam-handles`,
    // re-points this binding (the database_id and name only) and archives or
    // deletes the test one (the founder, 2026-11-17; no staging split before then).
    // The same cut sets ENVIRONMENT to "production" and deletes
    // HANDLES_SKIP_UNBUILT_GATES (docs/runbooks/handles-build.md, the cut's checklist).
    // Migrations: `wrangler d1 migrations apply cofferdam-handles-sepolia --remote`. No "remote": true,
    // unlike WORK_DB: wrangler dev then writes a local database, never the live one.
    { "binding": "HANDLES_DB", "database_name": "cofferdam-handles-sepolia", "database_id": "1e76a7d6-1c48-4abf-809a-bcacbc2aa66e", "migrations_dir": "migrations/handles" }
  ],
  "vectorize": [
    { "binding": "TOKEN_REGISTRY", "index_name": "token-registry-v2", "remote": true },
    { "binding": "JOBS_LISTINGS", "index_name": "jobs-listings-v2", "remote": true }
  ],

  // ─────────────────────────────────────────────────────────────────
  // R2 — the Vault mirror (workspace decision 0081; runbook
  // docs/runbooks/vault-build.md, step 4): sealed blobs and one snapshot
  // object (the sealed database with its key wrap) under each account's
  // lower-cased address. The bucket exists since 2026-11-10 (the founder,
  // docs/runbooks/cloudflare-deploys.md, The Vault bucket). No "remote": true,
  // unlike D1 and Vectorize: wrangler dev tolerates a missing token under
  // development, so a local run must write miniflare's local bucket, never the
  // live one.
  // ─────────────────────────────────────────────────────────────────
  "r2_buckets": [
    { "binding": "VAULT", "bucket_name": "cofferdam-vault" }
  ],

  // The handle registry's scheduled run (src/services/handles/cron.ts): the
  // sweep of expired share links and lapsed holds, then the announcement
  // indexer, which stays off until ANNOUNCEMENTS_FROM_BLOCK is set. Does
  // nothing while HANDLES_DB is unbound.
  "triggers": { "crons": ["* * * * *"] }

  // Bindings below are intentionally COMMENTED until their resources
  // are provisioned. Uncomment + fill IDs as we go through Sessions 4-N.
  //
  // ─────────────────────────────────────────────────────────────────
  // KV — session storage, profile pointers, Bloom filter snapshots,
  //      CompanyConsumerLink grants (rev-7.4 company plane).
  //
  // To light up the /v1/enterprise/links/* routes:
  //   1. wrangler kv namespace create LINKS
  //   2. paste the returned id below and uncomment the LINKS line
  //   (env.ts already declares `LINKS?: KVNamespace` as optional — no change there)
  // Until then the link routes return 503 link_store_unprovisioned and the
  // rest of the Worker (incl. /v1/enterprise/resolve) is unaffected.
  // ─────────────────────────────────────────────────────────────────
  // Add a `kv_namespaces` array once these are provisioned (env.ts declares
  // `LINKS?: KVNamespace` as optional):
  //   { "binding": "SESSIONS", "id": "<TBD-session-3>" },
  //   { "binding": "PROFILES", "id": "<TBD-after-T1.1>" },
  //   { "binding": "LINKS",    "id": "<TBD-run-wrangler-kv-namespace-create-LINKS>" },
  //   { "binding": "AI_PINS",  "id": "<TBD-run-wrangler-kv-namespace-create-AI_PINS>" }
  //
  // ─────────────────────────────────────────────────────────────────
  // R2 — more buckets (the Vault's is bound above)
  // ─────────────────────────────────────────────────────────────────
  //   { "binding": "SRS",   "bucket_name": "cofferdam-srs" }
  //
  // ─────────────────────────────────────────────────────────────────
  // D1 — non-sensitive metadata + audit logs
  // ─────────────────────────────────────────────────────────────────
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "cofferdam", "database_id": "<TBD>" }
  // ],
  //
  // ─────────────────────────────────────────────────────────────────
  // Durable Objects — SessionDO, ConversationDO, etc.
  // ─────────────────────────────────────────────────────────────────
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "SESSION_DO", "class_name": "SessionDO" }
  //   ]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_classes": ["SessionDO"] }
  // ],
}
